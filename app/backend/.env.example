# Copy to .env and adjust. .env is gitignored; never commit real credentials.
# Only what changes per machine belongs here. Which provider, collection, metric
# and model are design decisions and live in config/*.yaml.

# Server binding.
HOST=0.0.0.0
PORT=8000

# Connection target per provider. Both stay set: the factory reads the one
# belonging to the provider selected in vector_store.yaml, so switching
# provider for a benchmark run never means editing a url.
QDRANT_URL=http://localhost:6333
# A Milvus server uri, or a milvus-lite file path for dev/test (single process
# only -- it holds an exclusive flock and cannot serve N workers).
MILVUS_URI=http://localhost:19530

# Which yaml to load. Paths are relative to app/backend.
VECTOR_STORE_CONFIG_PATH=config/vector_store.yaml
EMBEDDING_CONFIG_PATH=config/embedding.yaml
