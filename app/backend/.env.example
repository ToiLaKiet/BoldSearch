# BoldSearch backend environment.
# Copy to `.env` (same directory, gitignored) — values below mirror app_config.py.
# Fill the two credential groups; secrets are intentionally blank here.

# ── Zilliz / Milvus credentials ──────────────────────────────
ZILLIZ_URI=
ZILLIZ_TOKEN=

# ── Hugging Face credentials ─────────────────────────────────
HF_TOKEN=

# ── Server ───────────────────────────────────────────────────
SYSTEM_NAME=BoldSearch
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000

# ── Milvus search settings ───────────────────────────────────
MILVUS_COLLECTION=BoldSearch
MILVUS_VECTOR_FIELD=embedding
MILVUS_OUTPUT_FIELDS=frame_id,shot_id,video_id,asr_text,ocr_text,distance,thumbnail
MILVUS_TEXT_SEARCH_PARAMS={"metric_type":"BM25"}
MILVUS_VECTOR_SEARCH_PARAMS={"metric_type":"IP","params":{"nprobe":10}}
MILVUS_RANKER_WEIGHTS=0.5,0.5
SEARCH_TOP_K=3000

# ── Embedding encoder ────────────────────────────────────────
LOAD_FG_CLIP_ON_STARTUP=true
FG_CLIP_DEVICE=mps

# ── Local data paths (relative to app/backend) ──────────────
DATA_DIR=../data
KEYFRAMES_DIR=../data/keyframes
KEYFRAME_MAP_DIR=../data/map-keyframes
EVALUATION_ARTIFACT_DIR=../data/evaluation-artifacts
OBJECTS_CSV_PATH=detections.csv

# ── Evaluation run labels (required for evaluation export) ──
# Human labels for provenance; hashes and encoder identity are computed.
EVALUATION_CORPUS_VERSION=
EVALUATION_PREPROCESSING_VERSION=
EVALUATION_QUERY_STRATEGY=

# ── Response presentation ────────────────────────────────────
FRAME_IMAGE_URL_TEMPLATE=
INCLUDE_EMBEDDING_IN_RESPONSE=false
