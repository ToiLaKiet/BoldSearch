# Copy to .env and adjust. Only VITE_-prefixed vars reach the client.

# Where the dev server proxies /api. Must match PORT in app/backend/.env.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Base path the app calls. Leave as /api to go through the proxy above; set a
# full origin only when talking to a deployed backend directly.
VITE_API_BASE=/api
