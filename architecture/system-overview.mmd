flowchart LR
  User["Người vận hành / thí sinh"] --> UI["Vite React UI"]
  UI --> API["FastAPI app (main.py, prefix /api)"]

  subgraph Backend["Backend modular monolith"]
    API --> Search["search router — hoạt động thật"]
    API --> Vector["vector router — ingest/search vector đã tính sẵn, hoạt động thật"]
    API --> Embedding["embedding router — stub, TODO"]
    API --> OCR["ocr router — stub, TODO"]
    API --> ASR["asr router — stub, TODO"]
    API --> ObjDet["object_detection router — stub, TODO"]

    Search --> Catalog["Danh mục shot (search/service.py)"]
    Search --> Scoring["Chấm điểm + gom nhóm thuần (search/service.py)"]

    Vector --> Store
    Embedding -. "chưa nối vào Store" .-> EncoderLoader

    subgraph EncInfra["encoders/ — hạ tầng, không import FastAPI"]
      EncoderLoader["encoders/loader.py — build_encoder(config)"]
      EncoderLoader --> FGCLIP["Adapter FG-CLIP"]
      EncoderLoader --> BEIT3["Adapter BEiT-3"]
      EmbeddingYAML["config/embedding.yaml"] --> EncoderLoader
    end

    subgraph VSInfra["vector_store/ — một Protocol trung lập theo provider"]
      Store["main.lifespan — một VectorStore mỗi worker"]
      Store --> Qdrant["QdrantStore — search + ingest"]
      Store --> Milvus["MilvusStore — search + ingest"]
    end
  end

  Catalog --> LocalJSON[("shots.json mẫu")]

  subgraph Offline["Pipeline offline + benchmark — chưa xây dựng"]
    Media["Video và keyframe"] --> Artifact["Artifact embedding + manifest"]
    Artifact --> Harness["Benchmark harness"]
    Harness --> Store
    Harness --> Report["Báo cáo benchmark + input cho ADR"]
  end
